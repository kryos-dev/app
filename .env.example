# Database (required)
DATABASE_URL=postgres://user:password@localhost:5432/zola

# Encryption key for secrets stored at rest (32 bytes, base64)
ENCRYPTION_KEY=your_base64_32_byte_key

# CSRF protection (required)
CSRF_SECRET=your_32_character_random_string

# Uploaded files. BLOB_DIR is the path inside the Zola container;
# BLOB_HOST_DIR is the same directory as the Hermes host sees it, used to tell
# the agent where a non-image attachment lives.
BLOB_DIR=/data/blobs
BLOB_HOST_DIR=/srv/zola/blobs

# Auth: the access service in front of the app sets the Remote-User header.
AUTH_URL=
# Dev only: act as this user when no header is present.
AUTH_DEV_USER=

# Hermes gateway (chat) and dashboard (skills, connectors, scheduled, audio, providers)
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_DASHBOARD_URL=http://127.0.0.1:9119
HERMES_DASHBOARD_USER=
HERMES_DASHBOARD_PASSWORD=

# Branding (optional)
NEXT_PUBLIC_APP_NAME=Zola
